def required_env(name)
  value = ENV[name]
  UI.user_error!("Set #{name} before running make release") if value.nil? || value.strip.empty?
  value
end

def required_file(name)
  path = File.expand_path(required_env(name), Dir.pwd)
  UI.user_error!("#{name} does not point to a readable file: #{path}") unless File.file?(path) && File.readable?(path)
  path
end

desc 'Build and upload to TestFlight and Google Play internal testing'
lane :release do
  root = File.expand_path('..', __dir__)
  Dir.chdir(root) do
    key_id = required_env('APP_STORE_CONNECT_KEY_ID')
    issuer_id = required_env('APP_STORE_CONNECT_ISSUER_ID')
    apple_key = required_file('APP_STORE_CONNECT_KEY_PATH')
    google_key = required_file('GOOGLE_PLAY_JSON_KEY_PATH')
    UI.user_error!('android/key.properties is required for a store-signed Android build') unless File.file?('android/key.properties')

    require 'fileutils'
    FileUtils.rm_rf('build/ios/ipa') # Avoid uploading an IPA left by a previous build.
    sh('flutter', 'pub', 'get')
    sh('flutter', 'build', 'ipa', '--release', '--export-method', 'app-store')
    sh('flutter', 'build', 'appbundle', '--release')

    ipa_files = Dir.glob('build/ios/ipa/*.ipa')
    UI.user_error!("Expected exactly one IPA in build/ios/ipa, found #{ipa_files.size}") unless ipa_files.size == 1
    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: apple_key)
    upload_to_testflight(ipa: File.expand_path(ipa_files.first), api_key: api_key, skip_waiting_for_build_processing: true)
    upload_to_play_store(
      package_name: 'com.motemagedon.app',
      json_key: google_key,
      aab: File.expand_path('build/app/outputs/bundle/release/app-release.aab'),
      track: 'internal',
      release_status: 'completed',
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
